    <script>
        function returnCodeComponent_<?= $uniqueId ?>() {
            return {
                // Component State
                copying: false,
                copied: false,
                showTooltip: false,
                tooltipText: '',
                
                // Return Code Data
                returnCode: '<?= $escaper->escapeJs($returnCode) ?>',
                
                // Computed Properties
                get buttonText() {
                    if (this.copying) {
                        return '<?= $escaper->escapeJs(__('Copying...')) ?>';
                    }
                    if (this.copied) {
                        return '<?= $escaper->escapeJs(__('Copied!')) ?>';
                    }
                    return this.returnCode;
                },
                
                // Component Lifecycle
                init() {
                    console.log('Return Code component initialized');
                },
                
                // Copy Functionality
                async copyReturnCode() {
                    if (this.copying || this.copied) {
                        return;
                    }
                    
                    this.copying = true;
                    
                    try {
                        if (navigator.clipboard && window.isSecureContext) {
                            // Modern clipboard API
                            await navigator.clipboard.writeText(this.returnCode);
                            this.handleCopySuccess();
                        } else {
                            // Fallback for older browsers
                            this.fallbackCopyToClipboard(this.returnCode);
                        }
                    } catch (error) {
                        console.error('Failed to copy return code:', error);
                        this.handleCopyError();
                    } finally {
                        this.copying = false;
                    }
                },
                
                // Fallback copy method for older browsers
                fallbackCopyToClipboard(text) {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    textArea.style.position = 'fixed';
                    textArea.style.left = '-999999px';
                    textArea.style.top = '-999999px';
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    
                    try {
                        const successful = document.execCommand('copy');
                        if (successful) {
                            this.handleCopySuccess();
                        } else {
                            this.handleCopyError();
                        }
                    } catch (error) {
                        console.error('Fallback copy failed:', error);
                        this.handleCopyError();
                    } finally {
                        document.body.removeChild(textArea);
                    }
                },
                
                // Success handler
                handleCopySuccess() {
                    this.copied = true;
                    this.showTooltip = true;
                    this.tooltipText = '<?= $escaper->escapeJs(__('Return code copied to clipboard!')) ?>';
                    
                    // Reset after 2 seconds
                    setTimeout(() => {
                        this.copied = false;
                        this.showTooltip = false;
                    }, 2000);
                },
                
                // Error handler
                handleCopyError() {
                    this.showTooltip = true;
                    this.tooltipText = '<?= $escaper->escapeJs(__('Failed to copy. Please select and copy manually.')) ?>';
                    
                    // Hide tooltip after 3 seconds
                    setTimeout(() => {
                        this.showTooltip = false;
                    }, 3000);
                }
            };
        }
        
        // Register with Alpine.js
        document.addEventListener('alpine:init', () => {
            Alpine.data('returnCodeComponent_<?= $uniqueId ?>', returnCodeComponent_<?= $uniqueId ?>);
        });
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
