<script>
function cargusMapComponent_<?= $uniqueId ?>() {
    return {
        // Component State
        isLoading: false,
        showModal: false,
        mapInitialized: false,
        mapError: null,
        mapInstance: null,
        
        // PUDO Data
        hasSelectedPudo: <?= $magewire->hasSelectedPudo() ? 'true' : 'false' ?>,
        selectedPudo: {
            id: '<?= $escaper->escapeJs($magewire->pudoId) ?>',
            name: '<?= $escaper->escapeJs($magewire->pudoName) ?>',
            address: '<?= $escaper->escapeJs($magewire->pudoAddress) ?>',
            latitude: '<?= $escaper->escapeJs($magewire->pudoLatitude) ?>',
            longitude: '<?= $escaper->escapeJs($magewire->pudoLongitude) ?>',
            type: '<?= $escaper->escapeJs($magewire->pudoType) ?>',
            paymentInfo: '<?= $escaper->escapeJs($magewire->paymentInfo) ?>'
        },
        
        // Cargus Configuration
        cargusData: <?= json_encode($magewire->getCargusData(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        
        // Component Lifecycle
        init() {
            console.log('Cargus PUDO component initialized');
            // Set up global callback for map marker selection
            window.selectPudoPoint_<?= $uniqueId ?> = this.selectPudo.bind(this);
        },
        
        // Map Management
        async openMapModal() {
            this.showModal = true;
            this.isLoading = true;
            this.mapError = null;
            
            try {
                await this.loadMapResources();
                await this.initializeMap();
            } catch (error) {
                this.mapError = error.message || '<?= $escaper->escapeJs(__('Failed to load map')) ?>';
                console.error('Map initialization error:', error);
            } finally {
                this.isLoading = false;
            }
        },
        
        closeModal() {
            this.showModal = false;
            if (this.mapInstance) {
                this.mapInstance.remove();
                this.mapInstance = null;
                this.mapInitialized = false;
            }
        },
        
        async loadMapResources() {
            // Use the existing global map object approach from the original implementation
            if (window.cargusMapInitialized && window.cargusMapObj) {
                return;
            }
            
            // Load external resources dynamically
            await this.loadExternalResources();
            
            // Initialize the global map object (similar to original implementation)
            this.initializeCargusMapObject();
        },
        
        async loadExternalResources() {
            const resources = [
                'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css',
                'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
            ];
            
            for (const url of resources) {
                await this.loadResource(url);
            }
        },
        
        loadResource(url) {
            return new Promise((resolve, reject) => {
                const isCSS = url.endsWith('.css');
                const existing = document.querySelector(
                    isCSS ? `link[href="${url}"]` : `script[src="${url}"]`
                );
                
                if (existing) {
                    resolve();
                    return;
                }
                
                let element;
                if (isCSS) {
                    element = document.createElement('link');
                    element.rel = 'stylesheet';
                    element.href = url;
                } else {
                    element = document.createElement('script');
                    element.src = url;
                }
                
                element.onload = resolve;
                element.onerror = () => reject(new Error(`Failed to load: ${url}`));
                
                document.head.appendChild(element);
            });
        },
        
        initializeCargusMapObject() {
            if (window.cargusMapInitialized) return;
            
            window.cargusMapInitialized = true;
            window.cargusMapObj = {
                map: null,
                markers: null,
                elementId: null,
                pins: this.cargusData.pins || [],
                
                init: (elemId) => {
                    if (!window.L) {
                        throw new Error('Leaflet library not loaded');
                    }
                    
                    const container = document.getElementById(elemId);
                    if (!container) {
                        throw new Error('Map container not found');
                    }
                    
                    // Clear existing map
                    if (this.mapInstance) {
                        this.mapInstance.remove();
                    }
                    
                    // Initialize map with customer location or default to Bucharest
                    let mapPosition = [44.4268, 26.1025]; // Default: Bucharest
                    let zoomLevel = 8; // Country-wide view as fallback (slightly closer)

                    // Check if customer location is available
                    if (this.cargusData.customerLocation) {
                        mapPosition = [
                            this.cargusData.customerLocation.lat,
                            this.cargusData.customerLocation.lng
                        ];
                        zoomLevel = 15; // Closer zoom for better PUDO visibility (reasonable level)
                        console.log('Centering map on customer location:', this.cargusData.customerLocation.region, mapPosition);
                    } else {
                        console.log('No customer location found, centering map on Bucharest with country view');
                    }
                    
                    this.mapInstance = L.map(container).setView(mapPosition, zoomLevel);
                    
                    // Add tile layer
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        minZoom: 5,
                        maxZoom: 18,
                        attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>'
                    }).addTo(this.mapInstance);
                    
                    // Add markers
                    this.addMapMarkers();
                    
                    return this.mapInstance;
                }
            };
        },
        
        async initializeMap() {
            if (!this.cargusData.pins || this.cargusData.pins.length === 0) {
                throw new Error('<?= $escaper->escapeJs(__('No pickup points available')) ?>');
            }

            // Wait for DOM to be ready
            await this.$nextTick();

            const containerId = 'cargus-map-container-<?= $uniqueId ?>';
            
            try {
                window.cargusMapObj.init(containerId);
                this.mapInitialized = true;
            } catch (error) {
                throw new Error('Failed to initialize map: ' + error.message);
            }
        },
        
        addMapMarkers() {
            if (!this.mapInstance || !this.cargusData.pins) return;
            
            const markers = [];
            const totalPins = this.cargusData.pins.length;
            
            console.log(`Adding ${totalPins} filtered PUDO markers to map`);
            
            this.cargusData.pins.forEach(pin => {
                const marker = L.marker([pin.latitude, pin.longitude])
                    .addTo(this.mapInstance);
                
                const popupContent = this.createPopupContent(pin);
                marker.bindPopup(popupContent);
                
                markers.push(marker);
            });
            
            // Only fit bounds if we have customer location and filtered results
            // Otherwise keep the initial zoom level for better performance
            if (markers.length > 0 && this.cargusData.customerLocation && totalPins < 100) {
                const group = new L.featureGroup(markers);
                // Add some padding and ensure minimum zoom level
                const bounds = group.getBounds().pad(0.2);
                this.mapInstance.fitBounds(bounds, {
                    maxZoom: 16, // Allow closer zoom to match new zoom level (increased from 14)
                    padding: [20, 20] // Add padding around markers
                });
            }
            
            // Add performance info to console
            if (this.cargusData.customerLocation) {
                console.log(`Performance optimization: Showing ${totalPins} nearby PUDO points instead of all 1900+`);
            }
        },
        
        createPopupContent(pin) {
            const paymentInfo = this.getPaymentInfo(pin.accepted_payment_type);

            // Main picture display
            const mainPicture = pin.main_picture ? `
                <div class="mb-2">
                    <img src="${this.escapeHtml(pin.main_picture)}" 
                         alt="${this.escapeHtml(pin.name)}" 
                         class="w-full object-cover rounded border"
                         onerror="this.style.display='none'">
                </div>
            ` : '';
            
            // Phone number display
            const phoneNumber = pin.phone_number ? `
                <p class="text-xs text-gray-600 mb-1">
                    <strong>📞 Phone:</strong> 
                    <a href="tel:${this.escapeHtml(pin.phone_number)}" class="text-blue-600 hover:text-blue-800">
                        ${this.escapeHtml(pin.phone_number)}
                    </a>
                </p>
            ` : '';
            
            // Open hours display
            const openHours = this.formatOpenHours(pin);
            
            // Address description display
            const addressDescription = pin.address_description ? `
                <div class="text-xs text-gray-600 mb-2 p-2 bg-gray-50 rounded border-l-2 border-blue-200">
                    <strong>ℹ️ Info:</strong><br>
                    <span class="whitespace-pre-line">${this.escapeHtml(pin.address_description).replace(/\n/g, '<br>')}</span>
                </div>
            ` : '';
            
            return `
                <div class="max-w-sm flex flex-col">
                    <!-- Fixed Header with Essential Info -->
                    <div class="flex-shrink-0 p-3 border-b border-gray-200">
                        ${mainPicture}
                        <h4 class="font-medium text-gray-900 mb-1">${this.escapeHtml(pin.name)}</h4>
                        <p class="text-sm text-gray-600 mb-1">${this.escapeHtml(pin.address)}</p>
                    </div>
                    
                    <!-- Scrollable Content Area -->
                    <div class="flex-1 overflow-y-auto p-3 space-y-2" style="max-height: 200px;">
                        ${phoneNumber}
                        ${openHours}
                        ${paymentInfo ? `<p class="text-xs text-gray-500">${paymentInfo}</p>` : ''}
                        ${addressDescription}
                    </div>
                    
                    <!-- Fixed Footer with Selection Button -->
                    <div class="flex-shrink-0 p-3 border-t border-gray-200 bg-white">
                        <button onclick="window.selectPudoPoint_<?= $uniqueId ?>('${pin.pudo_id}', '${this.escapeHtml(pin.name)}', '${this.escapeHtml(pin.address)}', '${pin.latitude}', '${pin.longitude}', '${pin.type}', '${paymentInfo}')"
                                class="w-full px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors">
                            <?= $escaper->escapeJs(__('Select This Point')) ?>
                        </button>
                    </div>
                </div>
            `;
        },
        
        formatOpenHours(pin) {
            // Check if any opening hours data exists
            const hasOpenHours = pin.open_hours_mo_start || pin.open_hours_tu_start || 
                                pin.open_hours_we_start || pin.open_hours_th_start || 
                                pin.open_hours_fr_start || pin.open_hours_sa_start || 
                                pin.open_hours_su_start;
            
            if (!hasOpenHours) {
                return '';
            }
            
            const days = [
                { key: 'mo', label: 'Mon', start: pin.open_hours_mo_start, end: pin.open_hours_mo_end },
                { key: 'tu', label: 'Tue', start: pin.open_hours_tu_start, end: pin.open_hours_tu_end },
                { key: 'we', label: 'Wed', start: pin.open_hours_we_start, end: pin.open_hours_we_end },
                { key: 'th', label: 'Thu', start: pin.open_hours_th_start, end: pin.open_hours_th_end },
                { key: 'fr', label: 'Fri', start: pin.open_hours_fr_start, end: pin.open_hours_fr_end },
                { key: 'sa', label: 'Sat', start: pin.open_hours_sa_start, end: pin.open_hours_sa_end },
                { key: 'su', label: 'Sun', start: pin.open_hours_su_start, end: pin.open_hours_su_end }
            ];
            
            // Group consecutive days with same hours
            const groupedHours = [];
            let currentGroup = null;
            
            days.forEach(day => {
                if (day.start && day.end) {
                    const hours = `${day.start}-${day.end}`;
                    
                    if (currentGroup && currentGroup.hours === hours) {
                        // Extend current group
                        currentGroup.endDay = day.label;
                    } else {
                        // Start new group
                        if (currentGroup) {
                            groupedHours.push(currentGroup);
                        }
                        currentGroup = {
                            startDay: day.label,
                            endDay: day.label,
                            hours: hours
                        };
                    }
                }
            });
            
            // Add the last group
            if (currentGroup) {
                groupedHours.push(currentGroup);
            }
            
            if (groupedHours.length === 0) {
                return '';
            }
            
            // Format the grouped hours
            const formattedHours = groupedHours.map(group => {
                const dayRange = group.startDay === group.endDay ? 
                    group.startDay : 
                    `${group.startDay}-${group.endDay}`;
                return `${dayRange}: ${group.hours}`;
            }).join('<br>');
            
            return `
                <div class="text-xs text-gray-600 mb-2">
                    <strong>🕒 Hours:</strong><br>
                    <span class="font-mono">${formattedHours}</span>
                </div>
            `;
        },
        
        getPaymentInfo(paymentType) {
            try {
                const payments = JSON.parse(paymentType || '{}');
                const info = [];
                if (payments.Cash) info.push('<?= $escaper->escapeJs(__('Cash')) ?>');
                if (payments.Card) info.push('<?= $escaper->escapeJs(__('Card')) ?>');
                if (payments.Online) info.push('<?= $escaper->escapeJs(__('Online')) ?>');
                return info.length > 0 ? '<?= $escaper->escapeJs(__('Payment methods')) ?>: ' + info.join(', ') : '';
            } catch (e) {
                return '';
            }
        },
        
        escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        },
        
        // PUDO Selection - Simplified to only pass pudoId
        // All PUDO data will be loaded from database by the Magewire component
        selectPudo(pudoId, name, address, latitude, longitude, type, paymentInfo = '') {
            // Update frontend state immediately for better UX
            this.selectedPudo = {
                id: pudoId,
                name: name,
                address: address,
                latitude: latitude,
                longitude: longitude,
                type: type,
                paymentInfo: paymentInfo
            };
            this.hasSelectedPudo = true;

            // Update Magewire component - only pass pudoId, it will load all data from database
            Magewire.find('<?= $magewire->id ?>').selectPudoPoint(pudoId);
            
            this.closeModal();
        },
        
        clearSelection() {
            this.selectedPudo = {
                id: '', name: '', address: '', latitude: '', longitude: '', type: '', paymentInfo: ''
            };
            this.hasSelectedPudo = false;
            
            // Update Magewire component
            Magewire.find('<?= $magewire->id ?>').clearPudoPoint();
        },
        
        retryMapLoad() {
            this.mapError = null;
            this.mapInitialized = false;
            this.openMapModal();
        }
    };
}

// Register with Alpine.js immediately
// Ensure Alpine is available before registering
if (typeof Alpine !== 'undefined') {
    Alpine.data('cargusMapComponent_<?= $uniqueId ?>', cargusMapComponent_<?= $uniqueId ?>);
} else {
    // Fallback: register when Alpine becomes available
    document.addEventListener('alpine:init', () => {
        Alpine.data('cargusMapComponent_<?= $uniqueId ?>', cargusMapComponent_<?= $uniqueId ?>);
    });
}
</script>
<?php $hyvaCsp->registerInlineScript() ?>